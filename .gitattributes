# Auto-detect text files and normalize line endings
* text=auto

# Source and configuration files
*.css text
*.html text
*.js text
*.json text
*.jsx text
*.md text
*.py text
*.toml text
*.ts text
*.tsx text
*.xml text
*.yaml text
*.yml text

# Force LF for shell scripts and CI configuration
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.pdf binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.xlsx binary

# Linguist overrides
*.min.js linguist-generated
*.min.css linguist-generated
package-lock.json linguist-generated
pnpm-lock.yaml linguist-generated
yarn.lock linguist-generated
